# Esempio di configurazione Supabase
# Copia questo file e rinominalo in .env.local
# Sostituisci i placeholder con le tue credenziali reali

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend Vercel: opzionale finché KingScore-Android è pubblica; necessario se privata.
# Token GitHub Contents:read, limitato a KingScore-Android.
# Non usare il prefisso VITE_ per questo segreto e non committare il valore.
GH_TOKEN=

# Abilitare solo dopo verifica delle RPC e del piano di passaggio completo.
VITE_ATOMIC_PLAY_WRITES=false

# NOTA:
# - VITE_SUPABASE_URL: Trovalo su Supabase Dashboard → Settings → API → Project URL
# - VITE_SUPABASE_ANON_KEY: Trovalo su Supabase Dashboard → Settings → API → anon public
# - Non condividere mai queste credenziali!
